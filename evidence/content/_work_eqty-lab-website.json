  },
  {
   "level": 2,
   "html": "<span>Trust in Machines: How EQTY Lab Brings </span><i><span>Integrity</span></i><span> to AI</span>",
   "text": "Trust in Machines: How EQTY Lab Brings Integrity to AI"
  },
  {
   "level": 3,
   "html": "Client",
   "text": "Client"
  },
  {
   "level": 4,
   "html": "<div class=\"inline-flex pr-[1em]\"><a class=\"ui-link\" target=\"_blank\" rel=\"nofollow noopener\" href=\"https://www.eqtylab.io/\"><span class=\"relative\"><span>EQTY Lab</span><span class=\"absolute -right-[1em] bottom-[0.5em] h-[0.5em] w-[0.5em]\"><svg viewBox=\"0 0 17.57 17.57\" class=\"fill-current\"><path d=\"M1.03 17.57c-.26 0-.53-.1-.73-.3-.4-.4-.4-1.06 0-1.46L14.04 2.07H1.03C.46 2.07 0 1.6 0 1.03S.46 0 1.",
   "text": "EQTY Lab"
  },
  {
   "level": 3,
   "html": "Category",
   "text": "Category"
  },
  {
   "level": 4,
   "html": "Brand + Website",
   "text": "Brand + Website"
  },
  {
   "level": 3,
   "html": "Date",
   "text": "Date"
  },
