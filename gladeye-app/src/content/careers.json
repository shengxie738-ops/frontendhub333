      }
    ],
    [
      {
        "t": "text",
        "v": "For those working IRL we offer an amazing home base… "
      },
      {
        "t": "a",
        "v": "Hamurana",
        "href": "https://www.heritage.org.nz/list-details/7733/Hamurana",
        "target": "_self",
        "linktype": "url"
      },
      {
        "t": "text",
        "v": " is one of New Zealand's finest extant homes of the 19th century, on the edge of Auckland's beautiful Albert Park -  now reborn as a state-of-the-art digital production studio."
      }
    ],
