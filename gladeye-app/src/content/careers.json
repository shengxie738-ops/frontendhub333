    ],
    [
      {
        "t": "text",
        "v": "We love seeing our people grow, and encourage everyone to do their best work together. "
      }
    ],
    [
      {
        "t": "text",
        "v": "Our team is largely based in NZ, but we do welcome remote designers, developers, creatives, strategists and producers who can work in (or near to) "
      },
      {
        "t": "a",
        "v": "our time zone",
        "href": "https://time.is/NZST",
