  "sections": [
    {
      "order": 1,
      "_uid": "9d6807ac-33c3-41a8-b5fa-51679fa5049f",
      "component": "page_bloks_content",
      "theme": "green",
      "heading": "Who we are",
      "lead": [
        {
          "t": "text",
          "v": "Gladeye is a creative digital agency from Aotearoa, New Zealand"
        },
        {
          "t": "span",
          "v": "—",
          "color": "rgb(77, 81, 86)"
        },
        {
          "t": "text",
          "v": "blending storytelling and technology."
        }
      ],
      "columns": [
        [
          {
            "t": "text",
            "v": "We partner with clients from New Zealand to New York to launch strikingly beautiful brand identities, storytelling experiences, campaigns, websites, ecommerce, and product designs."
          }
        ],
        [
          {
            "t": "text",
            "v": "We avoid work which accelerates wasteful consumerism; we love working with brands that promote sustainability and protect biodiversity."
          }
        ],
        [
          {
            "t": "text",
            "v": "Our team design brand identities that will distil your essence, craft campaigns to deeply engage your users, and build websites which bring joy and utility to peoples' lives."
          }
        ],
        [
          {
            "t": "text",
            "v": "Since our highly awarded long-form work with HuffPost Highline we've continued to push the boundaries of what's possible in browsers."
          }
        ],
        [
          {
            "t": "text",
            "v": "Our backgrounds in film, theatre, robotics, advertising and behavioural psychology let us bring worlds together to create storytelling experiences across multiple new media."
          }
        ],
        [
          {
            "t": "text",
            "v": "There is an incredible confluence of technologies happening in the digital<>human space. Interfaces are evolving and immersion is deepening at an order of magnitude. "
          }
        ],
        [
          {
            "t": "text",
            "v": "We believe that by keeping the twin concerns of people and planet at the "
          },
          {
            "t": "i",
            "v": "heart"
          },
          {
            "t": "text",
            "v": " of digital experiences - we can achieve a true net positive. "
          }
        ],
        [
          {
            "t": "text",
            "v": "Let’s make a more beautiful future together."
          }
        ]
      ],
      "media": []
    },
